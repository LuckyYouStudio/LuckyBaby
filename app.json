{
  "expo": {
    "name": "幸运宝贝",
    "slug": "luckybaby",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.luckyyoustudio.luckybaby",
      "appleTeamId": "JU4P42JZ54",
      "usesAppleSignIn": true,
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "幸运宝贝",
        "CFBundleLocalizations": [
          "zh-Hans",
          "en"
        ],
        "CFBundleDevelopmentRegion": "zh-Hans",
        "NSPhotoLibraryAddUsageDescription": "用来把家庭邀请二维码保存到你的相册，方便发给家人。/ Used to save the family invite QR code to your photo library so you can send it to relatives."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#DFF0E9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.luckyyoustudio.luckybaby",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "luckybaby",
              "host": "join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "versionCode": 4
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {}
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "用来从相册选取产检报告单照片，放进对应的那次产检里。/ Used to pick checkup report photos from your library and attach them to the matching checkup.",
          "cameraPermission": "用来扫描家人分享的邀请二维码，以及拍下产检报告单存进对应的产检。/ Used to scan a family invite QR code and to photograph checkup reports for the matching checkup.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "用来扫描家人分享的邀请二维码，以及拍下产检报告单存进对应的产检。/ Used to scan a family invite QR code and to photograph checkup reports for the matching checkup.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-localization",
      "expo-apple-authentication",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Boy",
            "ios": "./assets/icon-boy.png",
            "android": {
              "foregroundImage": "./assets/android-icon-boy-foreground.png",
              "backgroundColor": "#DFF0E9"
            }
          }
        ]
      ],
      "@react-native-community/datetimepicker"
    ],
    "scheme": "luckybaby",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d541636c-b80f-4c66-83ea-2087f33dacb7"
      }
    },
    "owner": "william1992"
  }
}
